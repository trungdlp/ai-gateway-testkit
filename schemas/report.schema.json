{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trungdlp/ai-gateway-testkit/schemas/report.schema.json",
  "title": "AI Gateway Testkit canonical report",
  "type": "object",
  "required": ["schema_version", "catalog_version", "catalog_digest", "run_id", "started_at", "duration_ms", "build", "runtime", "target", "selected_profiles", "profiles", "summary", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_version": {"type": "string"},
    "catalog_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "build": {"type": "object"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "target": {"type": "object"},
    "selected_profiles": {"type": "array", "items": {"type": "string"}},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}},
    "summary": {"type": "object"},
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "status": {"enum": ["pass", "fail", "error", "blocked", "skipped", "not_applicable"]},
    "runtime": {
      "type": "object",
      "required": ["os", "arch", "go_version", "dependency_versions", "retry"],
      "properties": {
        "os": {"type": "string"},
        "arch": {"type": "string"},
        "go_version": {"type": "string"},
        "dependency_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "retry": {"$ref": "#/$defs/retry"}
      }
    },
    "retry": {
      "type": "object",
      "required": ["max_retries", "initial_backoff_ms", "max_backoff_ms", "raw_http_requests", "raw_http_attempts", "raw_http_retries", "exhausted"],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 10},
        "initial_backoff_ms": {"type": "integer", "minimum": 0},
        "max_backoff_ms": {"type": "integer", "minimum": 0},
        "raw_http_requests": {"type": "integer", "minimum": 0},
        "raw_http_attempts": {"type": "integer", "minimum": 0},
        "raw_http_retries": {"type": "integer", "minimum": 0},
        "exhausted": {"type": "integer", "minimum": 0}
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "version", "title", "verdict", "required", "evaluated", "passed", "failed", "indeterminate", "success_ratio", "coverage_ratio"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "title": {"type": "string"},
        "verdict": {"enum": ["PASS", "FAIL", "INDETERMINATE"]},
        "required": {"type": "integer", "minimum": 0},
        "evaluated": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "indeterminate": {"type": "integer", "minimum": 0},
        "success_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "failure_ids": {"type": "array", "items": {"type": "string"}},
        "indeterminate_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "revision", "title", "layer", "suite", "area", "status", "duration_ms", "assertions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{2,4}-[A-Z]{3,5}-[0-9]{3}$"},
        "revision": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "layer": {"enum": ["protocol", "sdk", "behavioral", "agent", "security", "resilience"]},
        "suite": {"type": "string"},
        "area": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
        "evidence": {"type": "object"}
      }
    },
    "assertion": {
      "type": "object",
      "required": ["id", "title", "requirement", "impact", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{2,4}-[A-Z]{3,5}-[0-9]{3}/A[0-9]{2}$"},
        "title": {"type": "string"},
        "requirement": {"enum": ["must", "should", "may"]},
        "impact": {"enum": ["blocker", "high", "medium", "low"]},
        "status": {"$ref": "#/$defs/status"},
        "reason_code": {"type": "string"},
        "message": {"type": "string"},
        "expected": {"type": "string"},
        "observed": {"type": "string"},
        "baseline_state": {"enum": ["new_failure", "resolved", "unchanged_failure", "unchanged_pass", "not_comparable"]}
      }
    }
  }
}
