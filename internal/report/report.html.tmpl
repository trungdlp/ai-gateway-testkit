<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ffffff">
  <meta http-equiv="Content-Security-Policy" content="{{.ContentPolicy}}">
  <title>{{.TargetName}} — {{.Title}}</title>
  <style>{{.CSS}}</style>
</head>
<body>
  <a class="visually-hidden-focusable skip-link" href="#main-content">Skip to report content</a>

  <nav class="navbar navbar-expand border-bottom sticky-top bg-body" aria-label="Report navigation">
    <div class="container-xl">
      <a class="navbar-brand d-flex align-items-center gap-2" href="#report-top" aria-label="AI Gateway Testkit report home">
        <svg class="brand-mark" viewBox="0 0 36 36" role="img" aria-label="AI Gateway Testkit"><path d="M18 2.8 31 10.3v15L18 32.8 5 25.3v-15L18 2.8Z"/><path d="m11.5 22 6.5-13 6.5 13M14.2 18.1h7.6M12 25.7h12"/></svg>
        <span><strong>AI Gateway Testkit</strong><small>Compatibility report</small></span>
      </a>
      <div class="d-flex align-items-center gap-2">
        <span class="badge text-bg-light border d-none d-md-inline-flex align-items-center gap-1 px-3 py-2">
          <svg class="icon icon-success" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 2.8 8.3 7 10 4.2-1.7 7-5.4 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
          {{if .SharingMode}}Share-safe{{else}}Full details{{end}}
        </span>
        <button class="btn btn-outline-secondary icon-btn" id="theme-toggle" type="button" aria-label="Switch color theme" aria-pressed="false">
          <svg class="theme-light-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="theme-dark-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.5A9 9 0 0 1 8.5 3.5a9 9 0 1 0 12 12Z"/></svg>
        </button>
        <button class="btn btn-primary d-none d-sm-inline-flex align-items-center gap-2" id="print-report" type="button">
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v7H7z"/></svg>
          Export PDF
        </button>
      </div>
    </div>
  </nav>

  <main id="main-content" class="container-xl py-4 py-lg-5">
    <header id="report-top" class="report-header mb-4 mb-lg-5">
      <div class="row align-items-center g-4">
        <div class="col-lg-8">
          <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
            <span class="status-badge status-{{.OverallStatus}}"><span class="status-mark"></span>{{.OverallLabel}}</span>
            <span class="text-body-secondary small">Generated {{.StartedAt}}</span>
          </div>
          <p class="report-eyebrow mb-2">AI Gateway Compatibility Report</p>
          <h1 class="display-5 fw-semibold mb-3">{{.TargetName}}</h1>
          <h2 class="h5 fw-semibold mb-2">{{.OverallHeadline}}</h2>
          <p class="lead text-body-secondary mb-4">{{.OverallDescription}}</p>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="small text-body-secondary">Target fingerprint</span>
            <code class="fingerprint">{{.Fingerprint}}</code>
            <button class="btn btn-sm btn-outline-secondary copy-button" type="button" data-copy="{{.Fingerprint}}" aria-label="Copy target fingerprint">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg>
              Copy
            </button>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="card score-card"><div class="card-body p-4">
            <span class="text-body-secondary small text-uppercase fw-semibold">Assertion pass rate</span>
            <div class="score-number mt-2">{{.PassPercentage}}<small>%</small></div>
            <progress class="report-progress score-progress mt-3" max="100" value="{{.PassPercentage}}">{{.PassPercentage}}%</progress>
            <div class="d-flex justify-content-between mt-2 small text-body-secondary"><span>{{.Passed}} passed</span><span>{{.Total}} total</span></div>
          </div></div>
        </div>
      </div>
    </header>

    <section class="mb-5" aria-labelledby="summary-title">
      <h2 class="visually-hidden" id="summary-title">Summary</h2>
      <div class="row row-cols-2 row-cols-lg-4 g-3">
        <div class="col"><div class="card summary-card h-100"><div class="card-body"><div class="summary-card-head"><span class="summary-label">Passed</span><svg class="summary-icon status-pass" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.1V12a8 8 0 1 1-4.7-7.3"/><path d="m8.5 11.5 2.4 2.4L21 3.8"/></svg></div><strong>{{.Passed}}</strong><small>Verified assertions</small></div></div></div>
        <div class="col"><div class="card summary-card h-100"><div class="card-body"><div class="summary-card-head"><span class="summary-label">Failed</span><svg class="summary-icon status-fail" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.6 3h6.8L21 8.6v6.8L15.4 21H8.6L3 15.4V8.6Z"/><path d="M12 7.5v5.2M12 16.5h.01"/></svg></div><strong class="text-danger">{{.Failed}}</strong><small>Confirmed gaps</small></div></div></div>
        <div class="col"><div class="card summary-card h-100"><div class="card-body"><div class="summary-card-head"><span class="summary-label">Unavailable</span><svg class="summary-icon status-indeterminate" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div><strong class="text-warning-emphasis">{{.Unavailable}}</strong><small>Unevaluated signals</small></div></div></div>
        <div class="col"><div class="card summary-card h-100"><div class="card-body"><div class="summary-card-head"><span class="summary-label">Evidence coverage</span><svg class="summary-icon icon-primary" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg></div><strong>{{.CoveragePercentage}}%</strong><small>{{.ProfilePasses}} of {{.ProfileTotal}} profiles pass</small></div></div></div>
      </div>
    </section>

    <section class="mb-5" aria-labelledby="visual-overview-title">
      <div class="section-title-row"><div class="section-heading"><span class="section-heading-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></svg></span><div><p class="section-kicker">Visual overview</p><h2 id="visual-overview-title">Result distribution</h2><p>Assertion outcomes and compatibility readiness at a glance.</p></div></div></div>
      <div class="row g-3">
        <div class="col-lg-5">
          <article class="card distribution-chart"><div class="card-body">
            <div class="chart-heading"><div><h3>Assertion outcomes</h3><p>{{.Total}} assertions evaluated</p></div><strong>{{.PassPercentage}}%</strong></div>
            <svg class="stacked-chart" viewBox="0 0 100 12" preserveAspectRatio="none" role="img" aria-label="{{.Passed}} passed, {{.Failed}} failed, and {{.Unavailable}} unavailable assertions">
              <rect class="chart-track" x="0" y="0" width="100" height="12"/>
              <rect class="chart-pass" x="0" y="0" width="{{.PassPercentage}}" height="12"/>
              <rect class="chart-fail" x="{{.FailedOffset}}" y="0" width="{{.FailedPercentage}}" height="12"/>
              <rect class="chart-unavailable" x="{{.UnavailableOffset}}" y="0" width="{{.UnavailablePercent}}" height="12"/>
            </svg>
            <div class="chart-legend">
              <div><span class="legend-swatch chart-pass"></span><span>Passed</span><strong>{{.Passed}}</strong></div>
              <div><span class="legend-swatch chart-fail"></span><span>Failed</span><strong>{{.Failed}}</strong></div>
              <div><span class="legend-swatch chart-unavailable"></span><span>Unavailable</span><strong>{{.Unavailable}}</strong></div>
            </div>
          </div></article>
        </div>
        <div class="col-lg-7">
          <article class="card h-100 profile-chart-card"><div class="card-body">
            <div class="chart-heading"><div><h3>Profile readiness</h3><p>Required assertion success by compatibility claim</p></div><strong>{{.ProfilePasses}}/{{.ProfileTotal}}</strong></div>
            <div class="profile-chart" role="list" aria-label="Compatibility profile success rates">
              {{range .Profiles}}
              <div class="profile-chart-row" role="listitem">
                <div class="profile-chart-label"><strong>{{.Title}}</strong><code>{{.ID}}</code></div>
                <progress class="report-progress status-{{.Verdict}}" max="100" value="{{.SuccessPercentage}}" aria-label="{{.Title}} success {{.SuccessPercentage}} percent">{{.SuccessPercentage}}%</progress>
                <strong class="profile-chart-value">{{.SuccessPercentage}}%</strong>
                <span class="status-badge status-{{.Verdict}}">{{.VerdictLabel}}</span>
              </div>
              {{end}}
            </div>
          </div></article>
        </div>
      </div>
    </section>

    {{if .Issues}}
    <section class="mb-5" aria-labelledby="attention-title">
      <div class="section-title-row"><div class="section-heading"><span class="section-heading-icon icon-danger"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 20h18.4Z"/><path d="M12 9v4M12 16.5h.01"/></svg></span><div><p class="section-kicker">Findings</p><h2 id="attention-title">Needs attention</h2></div></div><span class="badge text-bg-danger">{{len .Issues}} issue{{if ne (len .Issues) 1}}s{{end}}</span></div>
      <div class="card border-danger-subtle overflow-hidden"><div class="list-group list-group-flush">
        {{range .Issues}}
        <article class="list-group-item issue-item">
          <span class="status-dot status-{{.Status}}" aria-hidden="true"></span>
          <div class="flex-grow-1 min-w-0"><div class="d-flex align-items-center flex-wrap gap-2 mb-1"><code>{{.AssertionID}}</code><span class="status-badge status-{{.Status}}">{{.StatusLabel}}</span></div><h3 class="h6 mb-1">{{.Title}}</h3>{{if .Message}}<p class="small text-body-secondary mb-0">{{.Message}}</p>{{end}}</div>
          {{if .ReasonCode}}<code class="reason-code">{{.ReasonCode}}</code>{{end}}
        </article>
        {{end}}
      </div></div>
    </section>
    {{end}}

    <section class="mb-5" aria-labelledby="profiles-title">
      <div class="section-title-row">
        <div class="section-heading"><span class="section-heading-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 20 6v5c0 5-3.4 8.3-8 10-4.6-1.7-8-5-8-10V6Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></span><div><p class="section-kicker">Compatibility claims</p><h2 id="profiles-title">Profile details</h2><p>Coverage and evaluated requirements for every selected claim.</p></div></div>
        <div class="text-end d-none d-sm-block"><strong class="fs-4">{{.ProfilePasses}}/{{.ProfileTotal}}</strong><span class="d-block text-body-secondary small">profiles passed</span></div>
      </div>
      <div class="card overflow-hidden"><div class="table-responsive"><table class="table profile-table align-middle mb-0">
        <thead><tr><th scope="col">Profile</th><th scope="col">Verdict</th><th scope="col">Success</th><th scope="col">Coverage</th><th scope="col">Requirements</th><th scope="col">Version</th></tr></thead>
        <tbody>{{range .Profiles}}<tr><td><strong>{{.Title}}</strong><code>{{.ID}}</code></td><td><span class="status-badge status-{{.Verdict}}">{{.VerdictLabel}}</span></td><td><strong>{{.SuccessPercentage}}%</strong></td><td>{{.CoveragePercentage}}%</td><td>{{.Passed}} / {{.Required}}{{if .IssueCount}} <span class="text-danger">· {{.IssueCount}} review</span>{{end}}</td><td>v{{.Version}}</td></tr>{{end}}</tbody>
      </table></div></div>
    </section>

    <section class="mb-5" aria-labelledby="coverage-title">
      <div class="section-title-row"><div class="section-heading"><span class="section-heading-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 4.5-9 4.5-9-4.5Z"/><path d="m3 12 9 4.5 9-4.5M3 16.5 12 21l9-4.5"/></svg></span><div><p class="section-kicker">Coverage</p><h2 id="coverage-title">Tested surfaces</h2><p>Protocols and runtime provenance included in this evaluation.</p></div></div></div>
      <div class="row g-3">
        <div class="col-lg-8"><div class="row row-cols-1 row-cols-md-2 g-3 h-100">
          {{range .Endpoints}}
          <div class="col"><article class="card h-100 endpoint-card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4"><h3 class="h6 text-capitalize mb-0">{{.Protocol}}</h3><span class="badge text-bg-success-subtle text-success-emphasis">Evaluated</span></div>
            {{if $.SharingMode}}<div class="protected-details"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><div><strong>Connection details protected</strong><span>Endpoint and model removed for safe sharing.</span></div></div>
            {{else}}<dl class="metadata-list mb-0"><div><dt>Model</dt><dd>{{.Model}}</dd></div><div><dt>Endpoint</dt><dd>{{.BaseURL}}</dd></div>{{if .APIVersion}}<div><dt>API version</dt><dd>{{.APIVersion}}</dd></div>{{end}}</dl>{{end}}
          </div></article></div>
          {{end}}
        </div></div>
        <div class="col-lg-4"><article class="card h-100"><div class="card-body"><h3 class="h6 mb-3">Run telemetry</h3><dl class="metadata-list mb-0"><div><dt>Duration</dt><dd>{{.Duration}}</dd></div><div><dt>HTTP attempts</dt><dd>{{.RawHTTPAttempts}}</dd></div><div><dt>Recovered retries</dt><dd>{{.RawHTTPRetries}}</dd></div><div><dt>Runtime</dt><dd>{{.GoVersion}}</dd></div><div><dt>Platform</dt><dd>{{.Platform}}</dd></div></dl></div></article></div>
      </div>
    </section>

    <section class="scenario-section mb-5" aria-labelledby="scenarios-title">
      <div class="section-title-row">
        <div class="section-heading"><span class="section-heading-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5h11M9 12h11M9 19h11"/><path d="m3.5 5 1.2 1.2L7 3.8M3.5 12l1.2 1.2L7 10.8M3.5 19l1.2 1.2L7 17.8"/></svg></span><div><p class="section-kicker">Atomic evidence</p><h2 id="scenarios-title">Scenario results</h2><p>Every verdict traces to a stable scenario and assertion contract.</p></div></div>
        <div class="text-end d-none d-sm-block"><strong class="fs-4" id="visible-count">{{len .Scenarios}}</strong><span class="d-block text-body-secondary small">of {{len .Scenarios}} scenarios</span></div>
      </div>
      <div class="filter-toolbar card mb-3"><div class="card-body p-2 d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group filter-tabs" role="group" aria-label="Filter by result"><button class="btn btn-sm btn-outline-secondary active" type="button" data-filter="all" aria-pressed="true">All</button><button class="btn btn-sm btn-outline-secondary" type="button" data-filter="issues" aria-pressed="false">Issues</button><button class="btn btn-sm btn-outline-secondary" type="button" data-filter="pass" aria-pressed="false">Passed</button><button class="btn btn-sm btn-outline-secondary" type="button" data-filter="unavailable" aria-pressed="false">Unavailable</button></div>
        <label class="search-field flex-grow-1"><span class="visually-hidden">Search scenarios</span><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg><input class="form-control form-control-sm" id="scenario-search" type="search" placeholder="Search ID, title or reason code" autocomplete="off"></label>
        <button class="btn btn-sm btn-outline-secondary" id="expand-all" type="button">Expand all</button>
      </div></div>
      <div class="scenario-list" id="scenario-list">
        {{range .Scenarios}}
        <details class="card scenario-card status-border-{{.Status}}" data-status="{{.Status}}" data-search="{{.SearchText}}" {{if .DefaultExpanded}}open{{end}}>
          <summary class="card-header"><span class="status-dot status-{{.Status}}" aria-hidden="true"></span><span class="scenario-name"><code>{{.ID}}</code><strong>{{.Title}}</strong></span><span class="scenario-tags d-none d-lg-flex"><span>{{.Layer}}</span><span>{{.Suite}}</span><span>{{.Area}}</span></span><span class="scenario-result"><span class="status-badge status-{{.Status}}">{{.StatusLabel}}</span><small>{{.Duration}}</small></span><svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4"/></svg></summary>
          <div class="card-body scenario-body"><div class="small text-body-secondary mb-3">Revision {{.Revision}} · {{len .Assertions}} assertions{{if .IssueCount}} · <strong class="text-danger">{{.IssueCount}} issue{{if ne .IssueCount 1}}s{{end}}</strong>{{end}}</div>
            <div class="table-responsive"><table class="table assertion-table align-middle mb-0"><thead><tr><th scope="col">Status</th><th scope="col">Assertion</th><th scope="col">Requirement</th><th scope="col">Impact</th><th scope="col">Details</th></tr></thead><tbody>
              {{range .Assertions}}<tr><td><span class="status-badge status-{{.Status}}">{{.StatusLabel}}</span></td><td><code>{{.ID}}</code><strong>{{.Title}}</strong></td><td><span class="badge text-bg-light border">{{.Requirement}}</span></td><td><span class="badge text-bg-light border">{{.Impact}}</span></td><td class="assertion-detail-cell">{{if .ReasonCode}}<code class="reason-code">{{.ReasonCode}}</code>{{else}}<span class="text-body-secondary">—</span>{{end}}{{if .Message}}<p>{{.Message}}</p>{{end}}{{if .Expected}}<small>Expected</small><pre>{{.Expected}}</pre>{{end}}{{if .Observed}}<small>Observed</small><pre>{{.Observed}}</pre>{{end}}{{if .BaselineState}}<span class="badge text-bg-info-subtle">{{.BaselineState}}</span>{{end}}</td></tr>{{end}}
            </tbody></table></div>
            {{if .HasEvidence}}<details class="evidence-panel mt-3"><summary>View bounded evidence</summary><pre>{{.Evidence}}</pre></details>{{end}}
          </div>
        </details>
        {{end}}
      </div>
      <div class="card empty-state text-center" id="empty-state" hidden><div class="card-body py-5"><strong>No scenarios match</strong><p class="text-body-secondary small mb-0 mt-1">Try a different search term or result filter.</p></div></div>
    </section>

    <section aria-labelledby="provenance-title"><div class="card"><div class="card-body p-4"><div class="row g-4 align-items-start">
      <div class="col-lg-4"><p class="section-kicker">Provenance</p><h2 class="h4" id="provenance-title">Verifiable report metadata</h2><p class="text-body-secondary small mb-0">This HTML is derived from a canonical, versioned JSON report. Stable IDs keep results traceable across CI and release decisions.</p></div>
      <div class="col-lg-8"><dl class="provenance-grid mb-0"><div><dt>Run ID</dt><dd>{{.RunID}}</dd></div><div><dt>Started</dt><dd>{{.StartedAt}}</dd></div><div><dt>Catalog</dt><dd>{{.CatalogVersion}}</dd></div><div><dt>Schema</dt><dd>{{.SchemaVersion}}</dd></div><div><dt>Build</dt><dd>{{.BuildVersion}}</dd></div><div><dt>Commit</dt><dd>{{.BuildCommit}}</dd></div></dl></div>
    </div></div></div></section>
  </main>

  <footer class="border-top mt-5 py-4 bg-body-tertiary"><div class="container-xl d-flex flex-column flex-sm-row justify-content-between gap-2 small text-body-secondary"><span><strong class="text-body">AI Gateway Testkit</strong> · Compatibility you can verify</span><span>Generated {{.StartedAt}}</span></div></footer>
  <div class="toast-copy" id="toast" role="status" aria-live="polite">Copied to clipboard</div>
  <script>{{.Script}}</script>
</body>
</html>
