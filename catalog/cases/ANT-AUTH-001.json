{
  "id": "ANT-AUTH-001",
  "revision": 1,
  "title": "Anthropic authentication boundary",
  "description": "Verifies rejection and non-reflection of missing and invalid API keys.",
  "layer": "protocol",
  "suite": "anthropic",
  "area": "auth",
  "stability": "stable",
  "determinism": "deterministic",
  "spec_references": [
    {
      "title": "Anthropic API reference",
      "url": "https://docs.anthropic.com/en/api/overview"
    }
  ],
  "cost": {
    "requests": 2,
    "max_input_tokens": 128,
    "max_output_tokens": 64
  },
  "risk": {
    "mutation": "none",
    "cleanup_required": false,
    "contains_model_output": false
  },
  "assertions": [
    {
      "id": "A01",
      "title": "Missing credentials are rejected",
      "requirement": "must",
      "impact": "blocker"
    },
    {
      "id": "A02",
      "title": "Invalid credentials are rejected",
      "requirement": "must",
      "impact": "blocker"
    },
    {
      "id": "A03",
      "title": "Credentials are not reflected in error responses",
      "requirement": "must",
      "impact": "blocker"
    }
  ]
}
