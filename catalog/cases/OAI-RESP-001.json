  "title": "OpenAI non-streaming response",
  "description": "Creates and validates a minimal non-streaming Responses API result.",
  "layer": "protocol",
  "suite": "openai",
  "area": "responses",
  "stability": "stable",
  "determinism": "deterministic",
  "spec_references": [
    {
      "title": "OpenAI API reference",
